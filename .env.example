# MesaLista: copiar a .env.local en la raíz del repositorio.
# Completar únicamente en tu equipo con un proyecto Supabase de DESARROLLO.
# Nunca subir .env.local, pegar claves en el chat ni usar NEXT_PUBLIC_/VITE_.

# Obligatoria: Project URL de Supabase > Connect (sin /rest/v1).
# Formato: https://<referencia-del-proyecto>.supabase.co (sin /rest/v1).
SUPABASE_URL=

# Obligatoria: clave Secret de Settings > API Keys, sólo para el servidor.
# Su valor empieza por sb_secret_. No usar publishable/anon.
SUPABASE_SECRET_KEY=

# Alternativa LEGADA, sólo si ya usas el JWT service_role en vez de Secret:
# SUPABASE_SERVICE_ROLE_KEY=

# Opcional. No es un secreto; sólo cambia el puerto del servidor local.
PORT=3000
