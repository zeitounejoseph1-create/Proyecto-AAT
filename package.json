{
  "name": "mesalista",
  "version": "0.1.0",
  "private": true,
  "description": "Reservaciones de restaurantes con Supabase y Vercel",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local scripts/dev-server.cjs",
    "test": "node --test reservation-api.test.cjs tests/diagnose.test.cjs",
    "test:database": "node --test scripts/verify-database.cjs tests/catalog.test.cjs",
    "test:browser": "node --test tests/browser.test.cjs",
    "test:all": "node --test reservation-api.test.cjs tests/diagnose.test.cjs scripts/verify-database.cjs tests/catalog.test.cjs tests/browser.test.cjs tests/search.test.cjs",
    "verify:production": "node scripts/verify-production-install.cjs",
    "diagnose:local": "node --env-file-if-exists=.env.local scripts/diagnose.cjs local",
    "diagnose:public": "node scripts/diagnose.cjs public",
    "test:search": "node --test tests/search.test.cjs"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "embedded-postgres": "18.6.0-beta.19",
    "pg": "8.16.3",
    "playwright": "1.62.1"
  }
}
